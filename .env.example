# Public URL of the deployed site (canonical URL, Open Graph, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# The contact form uses Netlify Forms (no keys): submissions are emailed to the address set in
# Netlify → Forms → Form notifications.

# Optional: raises the GitHub API limit for the activity panel from 60 to 5,000 requests/hour. Server-side only.
GITHUB_TOKEN=
