# Public URL of the deployed site (canonical URL, Open Graph, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com). Without these, the form says it isn't connected
# and points visitors to the email address instead of pretending to send.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Portfolio <hello@your-domain.com>".
CONTACT_FROM_EMAIL=
# Optional: where messages go (defaults to the email in content.ts).
CONTACT_TO_EMAIL=

# Optional: raises the GitHub API limit for the activity panel from 60 to 5,000 requests/hour. Server-side only.
GITHUB_TOKEN=
